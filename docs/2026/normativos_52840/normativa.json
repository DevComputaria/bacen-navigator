yle=\"height&#58;32.55pt;\">\n  <td width=\"236\" style=\"width&#58;177.05pt;border-top&#58;none;border-left&#58;none;border-bottom&#58;1pt solid windowtext;border-right&#58;1pt solid windowtext;padding&#58;0cm 5.4pt;height&#58;32.55pt;\"><span style=\"color&#58;rgb(68, 68, 68);\">\n  <p class=\"MsoPlainText\" style=\"margin-bottom&#58;6pt;\"><span style=\"font-family&#58;Calibri;font-size&#58;17.3333px;color&#58;rgb(68, 68, 68);\">Para órgãos e entidades da União</span></p>\n  <p class=\"MsoPlainText\"><span style=\"font-family&#58;Calibri;font-size&#58;17.3333px;color&#58;rgb(68, 68, 68);\">Até\n  R$400.000.000,00</span></p>\n  </span></td>\n </tr>\n <tr style=\"height&#58;91.8pt;\"><td width=\"47\" rowspan=\"3\" style=\"width&#58;35.15pt;border-right&#58;1pt solid windowtext;border-bottom&#58;1pt solid windowtext;border-left&#58;1pt solid windowtext;border-top&#58;none;padding&#58;0cm 5.4pt;height&#58;91.8pt;\">\n  <p class=\"MsoPlainText\" align=\"center\" style=\"text-align&#58;center;\"><span style=\"font-family&#58;Calibri;font-size&#58;17.3333px;color&#58;rgb(68, 68, 68);\">2021</span></p>\n  </td>\n  <td width=\"208\" rowspan=\"3\" style=\"width&#58;156.1pt;border-top&#58;none;border-left&#58;none;border-bottom&#58;1pt solid windowtext;border-right&#58;1pt solid windowtext;padding&#58;0cm 5.4pt;height&#58;91.8pt;\">\n  <p class=\"MsoPlainText\"><span style=\"font-family&#58;Calibri;font-size&#58;17.3333px;color&#58;rgb(68, 68, 68);\">Até\n  R$6.500.000.000,00</span></p>\n  </td>\n  <td width=\"236\" style=\"width&#58;177.05pt;border-top&#58;none;border-left&#58;none;border-bottom&#58;1pt solid windowtext;border-right&#58;1pt solid windowtext;padding&#58;0cm 5.4pt;height&#58;91.8pt;\"><span style=\"color&#58;rgb(68, 68, 68);\">\n  <p class=\"MsoPlainText\" style=\"margin-bottom&#58;6pt;\"><span style=\"font-family&#58;Calibri;font-size&#58;17.3333px;color&#58;rgb(68, 68, 68);\">Para órgãos e entidades dos estados,\n  do Distrito Federal e dos municípios, exc