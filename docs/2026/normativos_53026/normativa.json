;border-width&#58;medium;border-style&#58;none;border-color&#58;currentcolor;padding&#58;0cm;height&#58;21.25pt;\">\n    <p class=\"MsoNormal\" align=\"center\" style=\"margin&#58;0cm 0cm 6pt;text-align&#58;center;text-indent&#58;0cm;line-height&#58;normal;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">............</span></p>\n    </td>\n   </tr>\n   <tr style=\"height&#58;21.25pt;\"><td width=\"548\" style=\"width&#58;411pt;border-width&#58;1pt medium medium;border-style&#58;solid none none;border-color&#58;windowtext currentcolor currentcolor;padding&#58;0cm;height&#58;21.25pt;\">\n    <p class=\"MsoNormal\" align=\"left\" style=\"margin&#58;0cm 0cm 6pt 8.5pt;text-align&#58;left;text-indent&#58;0cm;line-height&#58;normal;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Operações\n    especiais</span></p>\n    </td>\n    <td width=\"76\" style=\"width&#58;2cm;border-width&#58;1pt medium medium;border-style&#58;solid none none;border-color&#58;windowtext currentcolor currentcolor;padding&#58;0cm;height&#58;21.25pt;\">\n    <p class=\"MsoNormal\" align=\"left\" style=\"margin&#58;0cm 0cm 6pt 8.5pt;text-align&#58;left;text-indent&#58;0cm;line-height&#58;normal;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">&#160;</span></p>\n    </td>\n   </tr>\n   <tr style=\"height&#58;21.25pt;\"><td width=\"548\" style=\"width&#58;411pt;padding&#58;0cm;height&#58;21.25pt;\">\n    <p class=\"MsoNormal\" align=\"left\" style=\"margin&#58;0cm 0cm 6pt 29.9pt;text-align&#58;left;text-indent&#58;0cm;line-height&#58;normal;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Agências\n    de turismo e meios de hospedagem de turismo – operações com instituições<b>\n    </b>autorizadas a operar em câmbio</span></p>\n    </td>\n    <td width=\"76\" style=\"width&#58;2cm;padding&#58;0cm;height&#58;21.25pt;\">\n    <p class=\"MsoNormal\" align=\"center\" style=\"margin&#58;0cm 0cm 6pt;text-align&#58;center;text-indent&#58;0cm;line-height&#58;normal;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">33606</span></p>\n    </td>\n   </tr>\n   <tr style=\"height&#58;21.25pt;\"><td width=\"548\" style=\"width&#58;411pt;padding&#58;0cm;height&#58;21.25pt;\">\n    <p class=\"MsoNormal\" align=\"left\" style=\"margin&#58;0cm 0cm 6pt 29.9pt;text-align&#58;left;text-indent&#58;0cm;line-height&#58;normal;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Vales e\n    reembolsos postais internacionais</span></p>\n    </td>\n    <td width=\"76\" style=\"width&#58;2cm;padding&#58;0cm;height&#58;21.25pt;\">\n    <p class=\"MsoNormal\" align=\"center\" style=\"margin&#58;0cm 0cm 6pt;text-align&#58;center;text-indent&#58;0cm;line-height&#58;normal;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">37097</span></p>\n    </td>\n   </tr>\n   <tr style=\"height&#58;21.25pt;\"><td width=\"548\" style=\"width&#58;411pt;padding&#58;0cm;height&#58;21.25pt;\">\n    <p class=\"MsoNormal\" align=\"left\" style=\"margin&#58;0cm 0cm 6pt 29.9pt;text-align&#58;left;text-indent&#58;0cm;line-height&#58;normal;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Obrigações\n    decorrentes do uso internacional de cartão ou de outro meio de pagamento\n    eletrônico com transferência de ativos virtuais</span></p>\n    </td>\n    <td width=\"76\" style=\"width&#58;2cm;padding&#58;0cm;height&#58;21.25pt;\">\n    <p class=\"MsoNormal\" align=\"center\" style=\"margin&#58;0cm 0cm 6pt;text-align&#58;center;text-indent&#58;0cm;line-height&#58;normal;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">34203</span></p>\n    </td>\n   </tr>\n   <tr style=\"height&#58;21.25pt;\"><td width=\"548\" style=\"width&#58;411pt;padding&#58;0cm;height&#58;21.25pt;\">\n    <p class=\"MsoNormal\"