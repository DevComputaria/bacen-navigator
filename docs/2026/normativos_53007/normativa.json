libri;font-size&#58;17.3333px;color&#58;#444444;\">Até\n  R$11.000.000.000,00</span></p>\n  </td>\n  <td width=\"180\" style=\"width&#58;134.7pt;border-width&#58;medium 1pt 1pt medium;border-style&#58;none solid solid none;border-color&#58;currentcolor windowtext windowtext currentcolor;padding&#58;0cm 5.4pt;height&#58;12.25pt;\">\n  <p class=\"MsoPlainText\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Até\n  R$24.000.000.000,00</span></p>\n  </td>\n </tr>\n <tr style=\"height&#58;12.8pt;\"><td width=\"47\" style=\"width&#58;35.15pt;border-width&#58;medium 1pt 1pt;border-style&#58;none solid solid;border-color&#58;currentcolor windowtext windowtext;padding&#58;0cm 5.4pt;height&#58;12.8pt;\">\n  <p class=\"MsoPlainText\" align=\"center\" style=\"text-align&#58;center;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">2019</span></p>\n  </td>\n  <td width=\"208\" style=\"width&#58;156.1pt;border-width&#58;medium 1pt 1pt medium;border-style&#58;none solid solid none;border-color&#58;currentcolor windowtext windowtext currentcolor;padding&#58;0cm 5.4pt;height&#58;12.8pt;\">\n  <p class=\"MsoPlainText\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Até\n  R$13.500.000.000,00</span></p>\n  </td>\n  <td width=\"236\" style=\"width&#58;177.05pt;border-width&#58;medium 1pt 1pt medium;border-style&#58;none solid solid none;border-color&#58;currentcolor windowtext windowtext currentcolor;padding&#58;0cm 5.4pt;height&#58;12.8pt;\">\n  <p class=\"MsoPlainText\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Até\n  R$11.000.000.000,00</span></p>\n  </td>\n  <td width=\"180\" style=\"width&#58;134.7pt;border-width&#58;medium 1pt 1pt medium;border-style&#58;none solid solid none;border-color&#58;currentcolor windowtext windowtext currentcolor;padding&#58;0cm 5.4pt;height&#58;12.8pt;\">\n  <p class=\"MsoPlainText\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Até\n  R$24.500.000.000,00</span></p>\n  </td>\n </tr>\n <tr style=\"height&#58;60.5pt;\"><td width=\"47\" rowspan=\"2\" style=\"width&#58;35.15pt;border-width&#58;medium 1pt 1pt;border-style&#58;none solid solid;border-color&#58;currentcolor windowtext windowtext;padding&#58;0cm 5.4pt;height&#58;60.5pt;\">\n  <p class=\"MsoPlainText\" align=\"center\" style=\"text-align&#58;center;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">2020</span></p>\n  </td>\n  <td width=\"208\" rowspan=\"2\" style=\"width&#58;156.1pt;border-width&#58;medium 1pt 1pt medium;border-style&#58;none solid solid none;border-color&#58;currentcolor windowtext windowtext currentcolor;padding&#58;0cm 5.4pt;height&#58;60.5pt;\">\n  <p class=\"MsoPlainText\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Até\n  R$9.000.000.000,00</span></p>\n  </td>\n  <td width=\"236\" style=\"width&#58;177.05pt;border-width&#58;medium 1pt 1pt medium;border-style&#58;none solid solid none;border-color&#58;currentcolor windowtext windowtext currentcolor;padding&#58;0cm 5.4pt;height&#58;60.5pt;\"><span style=\"color&#58;#444444;\">\n  <p class=\"MsoPlainText\" style=\"margin-bottom&#58;6pt;\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Para órgãos e entidades dos estados,\n  do Distrito Federal e dos municípios</span></p>\n  <p class=\"MsoPlainText\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Até\n  R$11.000.000.000,00</span></p>\n  </span></td>\n  <td width=\"180\" rowspan=\"2\" style=\"width&#58;134.7pt;border-width&#58;medium 1pt 1pt medium;border-style&#58;none solid solid none;border-color&#58;currentcolor windowtext windowtext currentcolor;padding&#58;0cm 5.4pt;height&#58;60.5pt;\">\n  <p class=\"MsoPlainText\"><span style=\"font-family&#58;calibri;font-size&#58;17.3333px;color&#58;#444444;\">Até\n  R$